{
  "functions": {
    "file-read": [
      {
        "binary": false,
        "code": "g++ -x c -E /path/to/input-file\n",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      },
      {
        "binary": false,
        "code": "g++ @/path/to/input-file\n",
        "comment": "The file is read and parsed as a list of files (one per line), the content is displayed as error messages.",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      }
    ],
    "file-write": [
      {
        "code": "g++ -x c /dev/null -o /path/to/input-file\n",
        "comment": "This actually deletes the file.",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      }
    ],
    "shell": [
      {
        "code": "g++ -wrapper /bin/sh,-s x\n",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      }
    ]
  }
}
